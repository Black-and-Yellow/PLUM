# Root-level environment configuration
# Copy to .env and fill in your values.
# Individual service env files are in backend/.env.example and frontend/.env.example

# ── Gemini API (used by backend) ──────────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here

# ── MongoDB (override for docker-compose) ─────────────────────────────────────
MONGODB_URL=mongodb://localhost:27017
DATABASE_NAME=plum_opd
