# Frontend environment variables
# Copy to .env.local for local development (Vite reads VITE_* vars)

# Google Gemini API key (used for client-side extraction in dev mode)
# Get one from: https://aistudio.google.com
VITE_GEMINI_API_KEY=your_gemini_api_key_here

# Gemini model to use
VITE_GEMINI_MODEL=gemini-2.5-flash

# Backend API base URL (only needed if not using Vite proxy)
# VITE_API_BASE_URL=http://localhost:8000
